# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfplan
tfplan
# NOTE: .terraform.lock.hcl is intentionally committed (pins provider versions).

# Credentials / kubeconfig
*kubeconfig*
*.json.key
service-account*.json
gha-creds-*.json

# OS / editor
.DS_Store
*.swp

# Rendered overlay temp dirs (deploy.sh)
k8s/overlays/.render.*

# Local env files (never commit)
*.env
secrets.env
